# Required in production
DATABASE_URL="postgresql://info_room_runtime.PROJECT_REF:RUNTIME_PASSWORD@aws-N-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-N-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require"
SESSION_SECRET="replace-this-with-at-least-24-random-characters"
ADMIN_STUDENT_NUMBERS=""
APP_ORIGIN="https://your-production-domain.example"
CLOSED_PERIOD_CRON_SECRET="replace-with-a-dedicated-24-character-minimum-secret"
MAINTENANCE_CRON_SECRET="replace-with-a-different-24-character-minimum-secret"
RETENTION_PURGE_ENABLED="false"
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Optional Discord Application controls. Leave every value blank for webhook-only mode.
# If any value is set, all seven values are required in every environment.
DISCORD_APPLICATION_ID=""
DISCORD_PUBLIC_KEY=""
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
DISCORD_CHANNEL_ID=""
DISCORD_ADMIN_ROLE_ID=""
# Comma-separated one-to-one bindings: discordUserId:studentNumber
# Example shape only: DISCORD_USER_ID:STUDENT_NUMBER,ANOTHER_DISCORD_USER_ID:ANOTHER_STUDENT_NUMBER
DISCORD_ADMIN_USER_MAP=""
# Required on Vercel production so rate limits use real per-client IPs.
# Keep false only for non-production or non-proxy local runs.
TRUST_FORWARDED_IP_HEADERS="true"

# Required production operations metadata. These are identifiers, not provider secrets.
OBSERVABILITY_PROVIDER=""
OBSERVABILITY_PROJECT_ID=""
OPERATIONS_ALERT_DESTINATION=""
OPERATIONS_ESCALATION_PATH=""
OPERATIONS_OWNER=""
# Local production checks may set this. Vercel and GitHub Actions provide their own commit SHA.
DEPLOYMENT_SHA=""

# Development-only toggles
RIRO_MOCK_LOGIN="false"
ENABLE_LOCAL_ADMIN="false"
ADMIN_LOGIN_ID=""
ADMIN_LOGIN_PASSWORD=""
ENABLE_LOCAL_STUDENT="false"
# Comma-separated local login ids for development only.
LOCAL_STUDENT_LOGIN_ID=""
# One shared password, or comma-separated passwords matching ids.
LOCAL_STUDENT_LOGIN_PASSWORD=""
# Optional; comma-separated values must match ids.
LOCAL_STUDENT_NUMBER=""

# Production-only emergency fallback for local student accounts.
ENABLE_PRODUCTION_LOCAL_STUDENT="false"

# Optional deployment smoke variables; never commit real values.
SMOKE_BASE_URL="https://your-production-domain.example"
RIRO_SMOKE_ID=""
RIRO_SMOKE_PASSWORD=""
SMOKE_ADMIN_ID=""
SMOKE_ADMIN_PASSWORD=""
SMOKE_CLOSED_LIST_DATE=""
SMOKE_CLOSED_LIST_PERIOD=""
SMOKE_CONFIRM_DISCORD_SEND=""
SMOKE_FORCE_DISCORD_SEND=""

# Optional external cron setup for notification polling and daily maintenance.
# Use cron-job.org API credentials locally; do not commit real API keys.
EXTERNAL_CRON_BASE_URL="https://your-production-domain.example"
CRON_JOB_ORG_API_KEY=""
# Optional: set these to update known jobs instead of matching by title + base URL.
CLOSED_PERIOD_CRON_JOB_ORG_JOB_ID=""
MAINTENANCE_CRON_JOB_ORG_JOB_ID=""
