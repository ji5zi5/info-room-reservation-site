generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String        @id @default(cuid())
  riroId            String?       @unique
  name              String
  studentNumber     String        @unique
  generation        Int
  role              String        @default("STUDENT")
  bookingStatus     String        @default("ACTIVE")
  restrictionReason String?
  restrictedUntil   DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  reservations      Reservation[]
  auditLogs         AuditLog[]
  sessions          Session[]
  sanctions         UserSanction[] @relation("SanctionTarget")
  sanctionsAuthored UserSanction[] @relation("SanctionActor")
  sanctionsRevoked  UserSanction[] @relation("SanctionRevoker")
  adminActionsAuthored AdminAction[] @relation("AdminActionActor")
  adminActionsTargeted AdminAction[] @relation("AdminActionTarget")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  csrfTokens CsrfToken[]
}

model CsrfToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([sessionId, expiresAt])
}

model PeriodSetting {
  id          String   @id @default(cuid())
  date        String
  studyPeriod String
  openTime    String
  closeTime   String
  capacity    Int      @default(10)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, studyPeriod])
}

model NotificationDelivery {
  id          String   @id @default(cuid())
  date        String
  studyPeriod String
  kind        String
  status      String
  messageIds  String   @default("[]")
  attempts    Int      @default(0)
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, studyPeriod, kind])
  @@index([date, status])
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

model Reservation {
  id          String   @id @default(cuid())
  date        String
  studyPeriod String
  status      String   @default("CONFIRMED")
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  adminActions AdminAction[]

  @@unique([userId, date, studyPeriod])
  @@index([date, studyPeriod, status])
}

model AdminAction {
  id           String      @id @default(cuid())
  actorId      String?
  actor        User?       @relation("AdminActionActor", fields: [actorId], references: [id])
  targetUserId String?
  targetUser   User?       @relation("AdminActionTarget", fields: [targetUserId], references: [id])
  reservationId String?
  reservation  Reservation? @relation(fields: [reservationId], references: [id])
  action       String
  reason       String?
  before       String?
  after        String?
  ipHash       String?
  createdAt    DateTime    @default(now())
  sanctions    UserSanction[]

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model UserSanction {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation("SanctionTarget", fields: [userId], references: [id])
  actorId        String?
  actor          User?        @relation("SanctionActor", fields: [actorId], references: [id])
  sourceActionId String?
  sourceAction   AdminAction? @relation(fields: [sourceActionId], references: [id])
  type           String
  status         String       @default("ACTIVE")
  reason         String
  startsAt       DateTime     @default(now())
  endsAt         DateTime?
  revokedAt      DateTime?
  revokedById    String?
  revokedBy      User?        @relation("SanctionRevoker", fields: [revokedById], references: [id])
  revokedReason  String?
  createdAt      DateTime     @default(now())

  @@index([userId, status, createdAt])
  @@index([actorId, createdAt])
  @@index([type, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  userId    String?
  action    String
  detail    String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}
