generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String        @id @default(cuid())
  riroId            String?       @unique
  name              String
  studentNumber     String        @unique
  generation        Int
  role              String        @default("STUDENT")
  bookingStatus     String        @default("ACTIVE")
  shadowBanProfile  String        @default("NORMAL")
  restrictionReason String?
  restrictedUntil   DateTime?
  departedAt        DateTime?
  anonymizedAt      DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  reservations      Reservation[]
  auditLogs         AuditLog[]
  sessions          Session[]
  sanctions         UserSanction[] @relation("SanctionTarget")
  sanctionsAuthored UserSanction[] @relation("SanctionActor")
  sanctionsRevoked  UserSanction[] @relation("SanctionRevoker")
  adminActionsAuthored AdminAction[] @relation("AdminActionActor")
  adminActionsTargeted AdminAction[] @relation("AdminActionTarget")

  @@index([departedAt, anonymizedAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  csrfTokens CsrfToken[]
}

model CsrfToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([sessionId, expiresAt])
}

model PeriodSetting {
  id          String   @id @default(cuid())
  date        String
  studyPeriod String
  openTime    String
  closeTime   String
  capacity    Int      @default(10)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, studyPeriod])
}

model NotificationDelivery {
  id          String   @id @default(cuid())
  date        String
  studyPeriod String
  kind        String
  status      String
  failureCode String?
  messageIds  String   @default("[]")
  attempts    Int      @default(0)
  lastError   String?
  nextAttemptAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, studyPeriod, kind])
  @@index([date, status])
}

model OperationalJob {
  job                 String   @id
  status              String
  startedAt           DateTime
  finishedAt          DateTime?
  lastSuccessAt       DateTime?
  lastAttemptAt       DateTime
  result              String?
  durationMs          Int?
  failureCode         String?
  oldestBacklogAt     DateTime?
  backlogCount        Int      @default(0)
  consecutiveFailures Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, lastAttemptAt])
}

model NotificationSetting {
  id                                      String   @id
  closedPeriodNotificationsEnabled       Boolean  @default(true)
  reservationCreatedNotificationsEnabled Boolean  @default(false)
  createdAt                               DateTime @default(now())
  updatedAt                               DateTime @updatedAt
}

model RetentionPolicy {
  id                       String   @id
  enabled                  Boolean  @default(false)
  policyVersion            String   @default("unapproved")
  reservationReasonDays    Int?
  adminDetailDays          Int?
  sanctionReasonDays       Int?
  auditDetailDays          Int?
  departedUserIdentityDays Int?
  approvedBy               String?
  approvedAt               DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

model Reservation {
  id          String   @id @default(cuid())
  date        String
  studyPeriod String
  status      String   @default("CONFIRMED")
  reason      String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  adminActions AdminAction[]
  discordInteractionReceipt DiscordInteractionReceipt?
  discordReservationMessage DiscordReservationMessage?

  @@unique([userId, date, studyPeriod])
  @@index([date, studyPeriod, status])
}

model DiscordReservationMessage {
  reservationId            String      @id
  reservation              Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  nonce                    String      @unique @db.VarChar(25)
  guildId                  String?
  channelId                String?
  messageId                String?     @unique
  initialSendStatus        String      @default("PENDING")
  initialSendOutcome       String?
  initialSendAttempts      Int         @default(0)
  initialSendNextAttemptAt DateTime?   @default(now())
  initialSendError         String?
  initialSendClaimId       String?
  initialSendClaimedAt     DateTime?
  decision                 String?
  decisionDiscordActorId   String?
  decisionLocalActorId     String?
  decidedAt                DateTime?
  messageRevision          Int         @default(0)
  syncedRevision           Int         @default(0)
  syncStatus               String      @default("PENDING")
  syncAttempts             Int         @default(0)
  syncNextAttemptAt        DateTime?
  syncError                String?
  syncClaimId              String?
  syncClaimRevision        Int?
  syncClaimedAt            DateTime?
  expiresAt                DateTime    @default(dbgenerated("(CURRENT_TIMESTAMP + interval '30 days')"))
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  @@index([initialSendStatus, initialSendNextAttemptAt])
  @@index([syncStatus, syncNextAttemptAt])
  @@index([expiresAt])
}

model DiscordInteractionReceipt {
  interactionId   String      @id
  reservationId   String      @unique
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  messageId       String?
  intent          String
  discordActorId  String
  localActorId    String
  status          String
  terminalOutcome String
  terminalResult  Json
  expiresAt       DateTime    @default(dbgenerated("(CURRENT_TIMESTAMP + interval '30 days')"))
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([expiresAt, status])
}

model AdminAction {
  id           String      @id @default(cuid())
  actorId      String?
  actor        User?       @relation("AdminActionActor", fields: [actorId], references: [id])
  targetUserId String?
  targetUser   User?       @relation("AdminActionTarget", fields: [targetUserId], references: [id])
  reservationId String?
  reservation  Reservation? @relation(fields: [reservationId], references: [id])
  action       String
  reason       String?
  before       String?
  after        String?
  ipHash       String?
  createdAt    DateTime    @default(now())
  sanctions    UserSanction[]

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model UserSanction {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation("SanctionTarget", fields: [userId], references: [id])
  actorId        String?
  actor          User?        @relation("SanctionActor", fields: [actorId], references: [id])
  sourceActionId String?
  sourceAction   AdminAction? @relation(fields: [sourceActionId], references: [id])
  type           String
  status         String       @default("ACTIVE")
  reason         String
  startsAt       DateTime     @default(now())
  endsAt         DateTime?
  revokedAt      DateTime?
  revokedById    String?
  revokedBy      User?        @relation("SanctionRevoker", fields: [revokedById], references: [id])
  revokedReason  String?
  createdAt      DateTime     @default(now())

  @@index([userId, status, createdAt])
  @@index([actorId, createdAt])
  @@index([type, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  userId    String?
  action    String
  detail    String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}
