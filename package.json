{
  "name": "info-room-reservation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "npm run predeploy:check && prisma generate && prisma migrate deploy && tsx scripts/apply-online-admin-search-indexes.ts && next build",
    "lint": "npm run typecheck",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "qa:operational": "node scripts/verify-operational-fomo-evidence.mjs --mode attempt",
    "qa:operational:core": "node scripts/verify-operational-fomo-evidence.mjs --mode core",
    "verify:receipts": "node scripts/verify-readiness-receipts.mjs",
    "test:watch": "vitest",
    "smoke:external": "tsx scripts/external-smoke.ts",
    "discord:verify-setup": "npx tsx scripts/verify-discord-setup.ts",
    "discord:disable-pending": "npx tsx scripts/disable-discord-pending.ts",
    "discord:fixture": "npx tsx scripts/discord-interaction-fixture.ts",
    "discord:smoke": "npx prisma generate && npx tsx scripts/discord-interaction-smoke.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy && tsx scripts/apply-online-admin-search-indexes.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "cron:setup:external": "tsx scripts/setup-cron-job-org.ts",
    "predeploy:check": "tsx scripts/predeploy-check.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cheerio": "^1.1.2",
    "ky": "^1.14.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.11",
    "pg": "^8.23.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "embedded-postgres": "16.14.0-beta.17",
    "prisma": "^6.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "^0.35.3"
  }
}
